# Copy to .env and fill in real values. Never commit .env.
# All integrations are optional — the workflow works fully manually without them.

# JIRA (optional, Step 1 - read-jira-story skill, REST fallback when the Atlassian MCP server isn't set up)
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-domain.atlassian.net/
JIRA_USER=your-email@example.com
JIRA_TOKEN=your-jira-api-token-here
# Optional: restrict read-jira-story to this project key (e.g. PROJ). Bare issue numbers are
# expanded to PROJ-123; a key for a different project triggers a confirmation instead of fetching it.
JIRA_PROJECT=your-project-key-here

# GitHub (optional, Step 8 - generate-pr-github skill)
# Not needed if you use `gh auth login` or the GitHub MCP server (VS Code signs you in).
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repository-name
GITHUB_TOKEN=ghp_your-github-token-here
